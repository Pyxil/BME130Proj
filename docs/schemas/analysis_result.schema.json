{
  "$defs": {
    "ComponentScore": {
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "name": {
          "enum": [
            "phoneme_accuracy",
            "acoustic_similarity",
            "syllable_completeness",
            "temporal",
            "spectral_similarity",
            "loudness_contour",
            "pitch_contour",
            "minimal_pair_contrast"
          ],
          "title": "Name",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "weight": {
          "description": "Configured weight (renormalised over available components).",
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name",
        "weight",
        "available"
      ],
      "title": "ComponentScore",
      "type": "object"
    },
    "EngineInfo": {
      "properties": {
        "calibration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "phoneme_level": {
          "description": "True if the engine produced genuine phoneme-level scores.",
          "title": "Phoneme Level",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "phoneme_level"
      ],
      "title": "EngineInfo",
      "type": "object"
    },
    "Issue": {
      "properties": {
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        },
        "id": {
          "description": "Stable identifier within this result; AI feedback must cite these.",
          "title": "Id",
          "type": "string"
        },
        "message": {
          "description": "Plain-language description generated from measured data.",
          "title": "Message",
          "type": "string"
        },
        "phoneme": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phoneme"
        },
        "position": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "realized_as": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Realized As"
        },
        "severity": {
          "enum": [
            "minor",
            "moderate",
            "major"
          ],
          "title": "Severity",
          "type": "string"
        },
        "type": {
          "enum": [
            "substitution",
            "deletion",
            "unclear_articulation",
            "insertion",
            "syllable_missing",
            "extra_syllable",
            "too_fast",
            "too_slow",
            "low_acoustic_similarity",
            "part_mismatch",
            "stress_pattern",
            "pitch_pattern"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "severity",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "MatchedVariant": {
      "properties": {
        "accent": {
          "title": "Accent",
          "type": "string"
        },
        "arpabet": {
          "items": {
            "type": "string"
          },
          "title": "Arpabet",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "ipa": {
          "title": "Ipa",
          "type": "string"
        }
      },
      "required": [
        "id",
        "accent",
        "ipa",
        "arpabet"
      ],
      "title": "MatchedVariant",
      "type": "object"
    },
    "MistakeCheck": {
      "description": "A common mistake the recording was compared against (minimal-pair standard).",
      "properties": {
        "description": {
          "description": "e.g. '/w/ instead of /r/ at the start of the word'.",
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "enum": [
            "substitution",
            "deletion"
          ],
          "title": "Kind",
          "type": "string"
        },
        "phoneme": {
          "description": "Expected sound (IPA).",
          "title": "Phoneme",
          "type": "string"
        },
        "position": {
          "title": "Position",
          "type": "integer"
        },
        "probability": {
          "description": "Calibrated chance that this mistake was made.",
          "maximum": 1,
          "minimum": 0,
          "title": "Probability",
          "type": "number"
        },
        "realized_as": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sound said instead (IPA); null when left out.",
          "title": "Realized As"
        }
      },
      "required": [
        "description",
        "kind",
        "phoneme",
        "position",
        "probability"
      ],
      "title": "MistakeCheck",
      "type": "object"
    },
    "PhonemeScore": {
      "properties": {
        "accepted_variant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Accepted allophone/accent realisation that explained the audio better, if any.",
          "title": "Accepted Variant"
        },
        "arpabet": {
          "description": "Expected phoneme (ARPAbet with stress).",
          "title": "Arpabet",
          "type": "string"
        },
        "deletion_probability": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deletion Probability"
        },
        "end_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End S"
        },
        "index": {
          "description": "Position in the expected phoneme sequence of the matched variant.",
          "title": "Index",
          "type": "integer"
        },
        "likely_realization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Most likely competing sound (IPA) when the expected one scored low.",
          "title": "Likely Realization"
        },
        "likely_realization_probability": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Likely Realization Probability"
        },
        "phoneme": {
          "description": "Expected phoneme (broad IPA).",
          "title": "Phoneme",
          "type": "string"
        },
        "posterior": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model probability that the expected sound (or an accepted variant of it) was produced.",
          "title": "Posterior"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Calibrated 0-100 phoneme score.",
          "title": "Score"
        },
        "start_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Approximate start time (seconds, trimmed audio).",
          "title": "Start S"
        },
        "status": {
          "enum": [
            "good",
            "fair",
            "poor",
            "missing",
            "unscored"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "index",
        "phoneme",
        "arpabet",
        "status"
      ],
      "title": "PhonemeScore",
      "type": "object"
    },
    "QualityIssue": {
      "properties": {
        "blocking": {
          "description": "If true the recording is rejected and the user is asked to record again.",
          "title": "Blocking",
          "type": "boolean"
        },
        "code": {
          "enum": [
            "too_short",
            "too_long",
            "no_speech",
            "too_quiet",
            "clipping",
            "noisy",
            "truncated_start",
            "truncated_end",
            "decode_error"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "blocking"
      ],
      "title": "QualityIssue",
      "type": "object"
    },
    "QualityReport": {
      "properties": {
        "clipping_ratio": {
          "default": 0.0,
          "title": "Clipping Ratio",
          "type": "number"
        },
        "duration_s": {
          "title": "Duration S",
          "type": "number"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/QualityIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "peak_dbfs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Dbfs"
        },
        "rms_dbfs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rms Dbfs"
        },
        "snr_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Estimated speech-to-background level difference in dB.",
          "title": "Snr Db"
        },
        "speech_duration_s": {
          "title": "Speech Duration S",
          "type": "number"
        },
        "speech_end_s": {
          "title": "Speech End S",
          "type": "number"
        },
        "speech_start_s": {
          "title": "Speech Start S",
          "type": "number"
        },
        "usable": {
          "title": "Usable",
          "type": "boolean"
        }
      },
      "required": [
        "usable",
        "duration_s",
        "speech_duration_s",
        "speech_start_s",
        "speech_end_s"
      ],
      "title": "QualityReport",
      "type": "object"
    },
    "SignalAnalysis": {
      "description": "Details of the signals-and-systems comparison (present when no phoneme model is used).",
      "properties": {
        "closest_words": {
          "description": "Words whose standards matched best.",
          "items": {
            "$ref": "#/$defs/WordMatch"
          },
          "title": "Closest Words",
          "type": "array"
        },
        "curves": {
          "anyOf": [
            {
              "$ref": "#/$defs/SignalCurves"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mistakes_checked": {
          "items": {
            "$ref": "#/$defs/MistakeCheck"
          },
          "title": "Mistakes Checked",
          "type": "array"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/SignalPart"
          },
          "title": "Parts",
          "type": "array"
        },
        "standard": {
          "description": "Best-matching standard recording, e.g. 'piper:en_US-libritts_r-medium:0'.",
          "title": "Standard",
          "type": "string"
        },
        "standard_variant": {
          "title": "Standard Variant",
          "type": "string"
        },
        "standards_compared": {
          "title": "Standards Compared",
          "type": "integer"
        },
        "target_rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1 = the target word was the closest match.",
          "title": "Target Rank"
        },
        "warp_factor": {
          "description": "Frequency-warp factor that best matched the user's voice to the standard.",
          "title": "Warp Factor",
          "type": "number"
        },
        "words_compared": {
          "default": 0,
          "title": "Words Compared",
          "type": "integer"
        }
      },
      "required": [
        "standard",
        "standard_variant",
        "standards_compared",
        "warp_factor"
      ],
      "title": "SignalAnalysis",
      "type": "object"
    },
    "SignalCurves": {
      "description": "Aligned loudness (and pitch) curves of the recording and the standard, for plotting.",
      "properties": {
        "part_edges": {
          "description": "Boundaries between parts on the 0..1 axis.",
          "items": {
            "type": "number"
          },
          "title": "Part Edges",
          "type": "array"
        },
        "standard_db": {
          "items": {
            "type": "number"
          },
          "title": "Standard Db",
          "type": "array"
        },
        "standard_pitch_st": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Standard Pitch St",
          "type": "array"
        },
        "t": {
          "description": "Position along the standard, 0..1.",
          "items": {
            "type": "number"
          },
          "title": "T",
          "type": "array"
        },
        "user_db": {
          "description": "User loudness in dB relative to its loudest frame.",
          "items": {
            "type": "number"
          },
          "title": "User Db",
          "type": "array"
        },
        "user_pitch_st": {
          "description": "Semitones relative to the median; null = unvoiced.",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "User Pitch St",
          "type": "array"
        }
      },
      "required": [
        "t",
        "user_db",
        "standard_db"
      ],
      "title": "SignalCurves",
      "type": "object"
    },
    "SignalPart": {
      "description": "One part of the word (a syllable, or the start / vowel / end of a one-syllable word).",
      "properties": {
        "end_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End S"
        },
        "high_band_diff_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "3.5-8 kHz energy (hiss of /s/, /sh/, /f/) vs. the standard, relative to the whole word.",
          "title": "High Band Diff Db"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "label": {
          "description": "Plain-language name, e.g. 'the first syllable', 'the end of the word'.",
          "title": "Label",
          "type": "string"
        },
        "loudness_diff_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Loudness of this part vs. the standard, relative to the whole word.",
          "title": "Loudness Diff Db"
        },
        "phonemes": {
          "description": "Expected sounds in this part (IPA, from the dictionary; not detected).",
          "items": {
            "type": "string"
          },
          "title": "Phonemes",
          "type": "array"
        },
        "relative_duration": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Length of this part relative to the standard, after allowing for overall speaking rate.",
          "title": "Relative Duration"
        },
        "similarity": {
          "description": "How closely this part matched the standard.",
          "maximum": 100,
          "minimum": 0,
          "title": "Similarity",
          "type": "integer"
        },
        "start_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where this part is in the user's recording (trimmed audio).",
          "title": "Start S"
        },
        "status": {
          "enum": [
            "good",
            "fair",
            "poor"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "index",
        "label",
        "phonemes",
        "similarity",
        "status"
      ],
      "title": "SignalPart",
      "type": "object"
    },
    "Strength": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "phoneme": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phoneme"
        },
        "position": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        }
      },
      "required": [
        "id",
        "message"
      ],
      "title": "Strength",
      "type": "object"
    },
    "SyllableReport": {
      "properties": {
        "completeness": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completeness"
        },
        "detected_nuclei": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detected Nuclei"
        },
        "expected": {
          "title": "Expected",
          "type": "integer"
        },
        "vowels_present": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vowels Present"
        }
      },
      "required": [
        "expected"
      ],
      "title": "SyllableReport",
      "type": "object"
    },
    "TimingReport": {
      "properties": {
        "rate_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "User duration / reference duration.",
          "title": "Rate Ratio"
        },
        "reference_duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Duration S"
        },
        "rhythm_deviation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mean |log| ratio of relative phone durations.",
          "title": "Rhythm Deviation"
        },
        "speech_duration_s": {
          "title": "Speech Duration S",
          "type": "number"
        }
      },
      "required": [
        "speech_duration_s"
      ],
      "title": "TimingReport",
      "type": "object"
    },
    "WordMatch": {
      "properties": {
        "similarity": {
          "maximum": 100,
          "minimum": 0,
          "title": "Similarity",
          "type": "integer"
        },
        "word": {
          "title": "Word",
          "type": "string"
        }
      },
      "required": [
        "word",
        "similarity"
      ],
      "title": "WordMatch",
      "type": "object"
    },
    "WordRecognition": {
      "properties": {
        "closest_word": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Practice word whose pronunciation best matches the decoding.",
          "title": "Closest Word"
        },
        "matches_target": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matches Target"
        },
        "phoneme_error_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Edit distance between the free decoding and the matched variant, divided by its length.",
          "title": "Phoneme Error Rate"
        },
        "recognized_phonemes": {
          "description": "Free phone decoding (IPA).",
          "items": {
            "type": "string"
          },
          "title": "Recognized Phonemes",
          "type": "array"
        }
      },
      "title": "WordRecognition",
      "type": "object"
    }
  },
  "properties": {
    "acoustic_similarity": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Acoustic Similarity"
    },
    "analysis_id": {
      "title": "Analysis Id",
      "type": "string"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/ComponentScore"
      },
      "title": "Components",
      "type": "array"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "confidence_factors": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Confidence Factors",
      "type": "object"
    },
    "confidence_label": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence Label",
      "type": "string"
    },
    "contract_version": {
      "default": "1.1.0",
      "title": "Contract Version",
