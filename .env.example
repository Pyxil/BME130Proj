# Copy to .env and adjust. Never commit .env (it is git-ignored).
# Every variable is optional for local development.

# --- Backend --------------------------------------------------------------
# development | testing | production   (production refuses insecure defaults)
APP_ENV=development
# SQLite for local development; PostgreSQL for shared/production environments, e.g.
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/voice_therapy
DATABASE_URL=sqlite:///./data/app.db
# JWT signing key. REQUIRED in production: at least 32 random characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Upload limit in bytes (8 s of 16 kHz WAV is about 260 kB)
MAX_UPLOAD_BYTES=2000000
# Concurrent CPU-bound analyses per backend process
MAX_CONCURRENT_ANALYSES=2
# Run Alembic migrations + seed words at startup; load models in the background at startup
AUTO_MIGRATE=true
WARMUP_ON_START=true

# --- Speech analysis --------------------------------------------------------
# auto | allosaurus | wav2vec2 | none   (auto = Allosaurus if installed, else acoustic baseline)
SA_ENGINE=auto
# SA_MODEL_DIR=./models
# Experimental wav2vec2 engine; allow downloading from the Hugging Face Hub at runtime (0/1)
# SA_WAV2VEC2_MODEL=facebook/wav2vec2-lv-60-espeak-cv-ft
# SA_ALLOW_MODEL_DOWNLOAD=0
# Score weights (engineering assumptions, not clinical values; renormalised automatically)
# SA_WEIGHT_PHONEME_ACCURACY=0.6
# SA_WEIGHT_ACOUSTIC_SIMILARITY=0.2
# SA_WEIGHT_SYLLABLE_COMPLETENESS=0.1
# SA_WEIGHT_TEMPORAL=0.1
# Progression thresholds (configurable, not clinical standards)
# SA_RATING_MASTERED=90
# SA_RATING_SATISFACTORY=70
# Reference voices for DTW comparison: <piper voice>:<speaker id>, comma-separated
# SA_TTS_VOICES=en_US-libritts_r-medium:0,en_US-libritts_r-medium:40,en_GB-vctk-medium:3
# Full JSON config (overrides defaults; see speech_analysis/config.py)
# SPEECH_ANALYSIS_CONFIG=./analysis-config.json

# --- AI feedback --------------------------------------------------------------
# auto | anthropic | ollama | rule_based   (auto: anthropic if ANTHROPIC_API_KEY is set,
# else ollama if OLLAMA_HOST is set, else rule-based)
LLM_PROVIDER=auto
# Claude (https://console.anthropic.com). Keep keys only in .env or your secret manager.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=low
# LLM_TIMEOUT_S=30
# Local open-source model via Ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# --- Frontend (Vite) ------------------------------------------------------------
# Backend URL for the dev-server proxy
VITE_API_PROXY_TARGET=http://localhost:8000
# true = use the in-browser mock API (UI work without the backend)
VITE_USE_MOCKS=false
